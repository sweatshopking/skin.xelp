<?xml version="1.0" encoding="UTF-8"?>
<!-- xelp: Poster Grid. A wall of posters you can move around in all four directions, with the
     title and year (or episode count) under each, and a thin scroll bar on the right. -->
<includes>
	<variable name="HubGreeting">
		<value condition="String.IsEqual(System.Time(xx),AM) + Integer.IsGreater(System.Time(h),4) + !String.IsEqual(System.Time(h),12)">Good morning  ·  $INFO[System.Date(DDDD MMMM D)]</value>
		<value condition="String.IsEqual(System.Time(xx),PM) + [String.IsEqual(System.Time(h),12) | Integer.IsLess(System.Time(h),6)]">Good afternoon  ·  $INFO[System.Date(DDDD MMMM D)]</value>
		<value>Good evening  ·  $INFO[System.Date(DDDD MMMM D)]</value>
	</variable>
	<variable name="GridTitleLabel">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.TVShowTitle)">$INFO[ListItem.TVShowTitle]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="GridSubLabel">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Season]x$INFO[ListItem.Episode] $INFO[ListItem.Title]</value>
		<value condition="Container.Content(seasons)">$INFO[ListItem.Property(NumEpisodes),, episodes]</value>
		<value condition="Container.Content(sets)">$INFO[ListItem.Property(NumMovies),, films]</value>
		<value>$INFO[ListItem.Year]</value>
	</variable>
	<include name="Viewtype57">
		<control type="group">
			<visible>Control.IsVisible(57)</visible>
			<!-- toolbar above the grid: Up from the top row -->
			<control type="group">
				<left>392</left>
				<top>436</top>
				<control id="57001" type="button">
					<width min="300" max="520">auto</width>
					<height>84</height>
					<onup>noop</onup>
					<ondown>57</ondown>
					<onleft>Back</onleft>
					<onright>noop</onright>
					<onclick>SetFocus(5001)</onclick>
					<font>Med24</font>
					<label>$LOCALIZE[31089]</label>
					<textoffsetx>40</textoffsetx>
					<textcolor>ffdadada</textcolor>
					<focusedcolor>ff222222</focusedcolor>
					<texturefocus border="28,12,10,14">views/button_fo.png</texturefocus>
					<texturenofocus border="32,12,12,12">views/button_nf.png</texturenofocus>
				</control>
			</control>
			<!-- Poster Grid -->
			<control id="57" type="panel">
				<left>396</left>
				<top>560</top>
				<width>3220</width>
				<height>1520</height>
				<onup>57001</onup>
				<ondown>noop</ondown>
				<onleft>Back</onleft>
				<onright>noop</onright>
				<pagecontrol>570</pagecontrol>
				<preloaditems>2</preloaditems>
				<orientation>vertical</orientation>
				<viewtype label="Poster Grid">icon</viewtype>
				<defaultcontrol always="true">0</defaultcontrol>
				<scrolltime easing="inout" tween="sine">250</scrolltime>
				<visible>$EXP[Exp_View_57]</visible>
				<itemlayout height="760" width="460">
					<control type="group">
						<left>40</left>
						<control type="image">
							<width>380</width>
							<height>570</height>
							<aspectratio align="center">scale</aspectratio>
							<texture background="true" colordiffuse="d0ffffff" fallback="views/movie_fallback.png">$VAR[PosterImage]</texture>
						</control>
								<control type="textbox">
									<left>24</left>
									<top>190</top>
									<width>332</width>
									<height>200</height>
									<font>Med28</font>
									<aligny>center</aligny>
									<align>center</align>
									<textcolor>ffbcbcbc</textcolor>
									<label>$INFO[ListItem.Label]</label>
									<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb))</visible>
								</control>
						<control type="image">
							<width>110</width>
							<height>110</height>
							<texture>$INFO[ListItem.VideoResolution,views/resolution/,.png]</texture>
						</control>
						<control type="image">
							<width>110</width>
							<height>110</height>
							<texture>views/OverlayWatched.png</texture>
							<visible>String.IsEqual(ListItem.Overlay,OverlayWatched.png) + [!Integer.IsEqual(ListItem.Property(NumEpisodes),0) | String.IsEmpty(ListItem.Property(NumEpisodes))]</visible>
						</control>
						<control type="label">
							<top>588</top>
							<width>380</width>
							<height>56</height>
							<font>Light22</font>
							<textcolor>ffd8d8d8</textcolor>
							<label>$VAR[GridTitleLabel]</label>
						</control>
						<control type="label">
							<top>648</top>
							<width>380</width>
							<height>48</height>
							<font>Light22</font>
							<textcolor>ff7a7c80</textcolor>
							<label>$VAR[GridSubLabel]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="760" width="460">
					<control type="group">
						<left>40</left>
						<control type="group"><!-- zoomgroup -->
						<animation center="190,285" easing="inout" effect="zoom" end="105" start="100" time="200" tween="sine">Focus</animation>
						<!-- amber frame -->
						<control type="image">
							<left>-8</left>
							<top>-8</top>
							<width>396</width>
							<height>586</height>
							<texture colordiffuse="ffe9a01e">common/white_square.png</texture>
							<visible>Control.HasFocus(57)</visible>
						</control>
						<control type="image">
							<width>380</width>
							<height>570</height>
							<aspectratio align="center">scale</aspectratio>
							<texture background="true" fallback="views/movie_fallback.png">$VAR[PosterImage]</texture>
						</control>
								<control type="textbox">
									<left>24</left>
									<top>190</top>
									<width>332</width>
									<height>200</height>
									<font>Med28</font>
									<aligny>center</aligny>
									<align>center</align>
									<textcolor>ffbcbcbc</textcolor>
									<label>$INFO[ListItem.Label]</label>
									<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb))</visible>
								</control>
						<control type="image">
							<width>110</width>
							<height>110</height>
							<texture>$INFO[ListItem.VideoResolution,views/resolution/,.png]</texture>
						</control>
						<control type="image">
							<width>110</width>
							<height>110</height>
							<texture>views/OverlayWatched.png</texture>
							<visible>String.IsEqual(ListItem.Overlay,OverlayWatched.png) + [!Integer.IsEqual(ListItem.Property(NumEpisodes),0) | String.IsEmpty(ListItem.Property(NumEpisodes))]</visible>
						</control>
						</control><!-- /zoomgroup -->
						<control type="label">
							<top>588</top>
							<width>380</width>
							<height>56</height>
							<font>Light22</font>
<scroll>false</scroll>
							<textcolor>ffe9a01e</textcolor>
							<label>$VAR[GridTitleLabel]</label>
						</control>
						<control type="label">
							<top>648</top>
							<width>380</width>
							<height>48</height>
							<font>Light22</font>
<scroll>false</scroll>
							<textcolor>ffa4a4a4</textcolor>
							<label>$VAR[GridSubLabel]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
			<!-- scroll bar -->
			<control id="570" type="scrollbar">
				<left>3664</left>
				<top>560</top>
				<width>12</width>
				<height>1520</height>
				<texturesliderbackground colordiffuse="30ffffff">common/white_square.png</texturesliderbackground>
				<texturesliderbar colordiffuse="80ffffff">common/white_square.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="ffe9a01e">common/white_square.png</texturesliderbarfocus>
				<orientation>vertical</orientation>
				<showonepage>false</showonepage>
				<onleft>57</onleft>
				<onright>noop</onright>
			</control>
		</control>
	</include>
</includes>
